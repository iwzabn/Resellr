{
  "name": "AIRecommendations",
  "type": "object",
  "properties": {
    "seller_id": {
      "type": "string"
    },
    "kind": {
      "type": "string",
      "enum": [
        "title",
        "description",
        "pricing",
        "category",
        "interest"
      ],
      "enumColors": [
        "blue",
        "purple",
        "green",
        "yellow",
        "pink"
      ]
    },
    "title": {
      "type": "string"
    },
    "detail": {
      "type": "string"
    },
    "basis": {
      "type": "string"
    },
    "is_estimate": {
      "type": "boolean",
      "default": false
    },
    "confidence": {
      "type": "number",
      "default": 0
    },
    "ref_listing_id": {
      "type": "string"
    },
    "data_points": {
      "type": "number",
      "default": 0
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "dismissed"
      ],
      "enumColors": [
        "blue",
        "gray"
      ],
      "default": "open"
    },
    "generated_by": {
      "type": "string"
    }
  },
  "required": [
    "seller_id",
    "kind",
    "title"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.seller_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "$or": [
        {
          "data.seller_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}