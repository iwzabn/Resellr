{
  "name": "LocationPreferences",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "share_location": {
      "type": "boolean",
      "default": false
    },
    "granularity": {
      "type": "string",
      "enum": [
        "hidden",
        "region",
        "city"
      ],
      "enumColors": [
        "gray",
        "blue",
        "green"
      ],
      "default": "region"
    },
    "city": {
      "type": "string"
    },
    "region": {
      "type": "string"
    },
    "disclosure_note": {
      "type": "string"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}