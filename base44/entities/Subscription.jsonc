{
  "name": "Subscription",
  "type": "object",
  "properties": {
    "user_id": {
      "type": "string"
    },
    "plan": {
      "type": "string",
      "enum": [
        "free",
        "premium"
      ],
      "enumColors": [
        "gray",
        "green"
      ],
      "default": "free"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "pending_payment",
        "cancelled"
      ],
      "enumColors": [
        "green",
        "yellow",
        "red"
      ],
      "default": "active"
    },
    "price_aud": {
      "type": "number",
      "default": 0
    },
    "listing_limit": {
      "type": "number",
      "default": 5
    },
    "current_period_end": {
      "type": "string"
    },
    "provider": {
      "type": "string"
    },
    "provider_reference": {
      "type": "string"
    }
  },
  "required": [
    "user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}