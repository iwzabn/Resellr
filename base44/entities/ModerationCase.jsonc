{
  "name": "ModerationCase",
  "type": "object",
  "properties": {
    "report_id": {
      "type": "string"
    },
    "case_type": {
      "type": "string",
      "enum": [
        "report",
        "assessment_review",
        "appeal"
      ],
      "enumColors": [
        "blue",
        "purple",
        "yellow"
      ],
      "default": "report"
    },
    "subject_type": {
      "type": "string"
    },
    "subject_id": {
      "type": "string"
    },
    "subject_label": {
      "type": "string"
    },
    "action": {
      "type": "string",
      "enum": [
        "none",
        "warning",
        "listing_removed",
        "account_limited",
        "account_suspended",
        "dismissed"
      ],
      "enumColors": [
        "gray",
        "yellow",
        "red",
        "red",
        "red",
        "blue"
      ],
      "default": "none"
    },
    "moderator_id": {
      "type": "string"
    },
    "moderator_name": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "appeal_status": {
      "type": "string",
      "enum": [
        "none",
        "submitted",
        "upheld",
        "denied"
      ],
      "enumColors": [
        "gray",
        "blue",
        "green",
        "red"
      ],
      "default": "none"
    },
    "appeal_note": {
      "type": "string"
    },
    "appeal_at": {
      "type": "string"
    },
    "appeal_outcome_note": {
      "type": "string"
    },
    "decided_at": {
      "type": "string"
    }
  },
  "required": [],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}